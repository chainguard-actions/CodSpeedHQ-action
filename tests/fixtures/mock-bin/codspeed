#!/bin/bash
# Mock CodSpeed runner for testing
# Simulates the behavior of the real codspeed binary

set -e

ALLOW_EMPTY=false
SUBCOMMAND=""

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    run)
      SUBCOMMAND="run"
      shift
      ;;
    --allow-empty)
      ALLOW_EMPTY=true
      shift
      ;;
    --mode=*)
      MODE="${1#--mode=}"
      shift
      ;;
    --token=*)
      shift
      ;;
    --working-directory=*)
      WORKING_DIR="${1#--working-directory=}"
      shift
      ;;
    --upload-url=*)
      shift
      ;;
    --instruments=*)
      shift
      ;;
    --mongo-uri-env-name=*)
      shift
      ;;
    --setup-cache-dir=*)
      shift
      ;;
    --go-runner-version=*)
      shift
      ;;
    --config=*)
      shift
      ;;
    --)
      shift
      BENCH_CMD="$*"
      break
      ;;
    *)
      shift
      ;;
  esac
done

if [ "$SUBCOMMAND" = "run" ]; then
  echo "CodSpeed mock runner: running benchmarks"
  if [ -n "$MODE" ]; then
    echo "Mode: $MODE"
  fi
  if [ -n "$WORKING_DIR" ]; then
    echo "Working directory: $WORKING_DIR"
  fi
  if [ -n "$BENCH_CMD" ]; then
    echo "Running: $BENCH_CMD"
    if [ -n "$WORKING_DIR" ]; then
      cd "$WORKING_DIR"
    fi
    eval "$BENCH_CMD"
  fi
  if [ "$ALLOW_EMPTY" = "true" ]; then
    echo "No benchmarks found (allow-empty=true, continuing)"
    exit 0
  fi
  echo "Mock benchmark run complete"
  exit 0
fi

echo "Unknown subcommand: $SUBCOMMAND"
exit 1
